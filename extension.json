{
  "apiVersion": 1,
  "id": "at365.wallpaper-slideshow",
  "name": "Applet.WallpaperSlideshow.at365",
  "displayName": "WallpaperSlideshow.at365",
  "version": "0.6.2",
  "minimumHostVersion": "0.66.1",
  "startupDelaySeconds": 30,
  "updateRepository": "yukichi-7sai/Applet.WallpaperSlideshow.at365",
  "runtime": "native",
  "entry": "Applet.WallpaperSlideshow.at365.exe",
  "description": "モニターごとの複数フォルダーから壁紙を再生。タイル・フォルダー監視・AppDock内の履歴に対応します。",
  "capabilities": [
    "ui",
    "settings",
    "local-images",
    "pages"
  ],
  "settings": [
    {
      "title": "停止",
      "key": "paused",
      "default": false,
      "description": "手動停止状態を保存します。ロック・リモート接続による停止は別に維持します。",
      "type": "boolean",
      "automation": true,
      "generateCommands": [
        "on",
        "off",
        "toggle"
      ]
    },
    {
      "maximum": 2147483,
      "title": "壁紙の更新間隔（秒）",
      "key": "intervalSeconds",
      "type": "number",
      "description": "長めの間隔ほど画像の読み込みとCPU使用を減らせます。",
      "default": 60,
      "step": 1,
      "minimum": 1,
      "automation": true
    },
    {
      "title": "モニターごとの画像設定",
      "key": "monitors",
      "default": [],
      "description": "左から右、同じX位置では上から下の画面順です。各モニターのフォルダー・表示モード・タイル枚数・余白を個別に設定します。",
      "type": "object-list",
      "fields": [
        {
          "key": "Folders",
          "title": "画像ソースフォルダー",
          "type": "string-list",
          "default": [],
          "aliases": [
            "Folder"
          ],
          "format": "directory"
        },
        {
          "key": "Mode",
          "title": "表示モード",
          "type": "select",
          "default": "Fit",
          "numericOptions": true,
          "options": [
            {
              "value": "Fill",
              "label": "Fill（画面いっぱい）"
            },
            {
              "value": "Fit",
              "label": "Fit（全体を表示）"
            },
            {
              "value": "Stretch",
              "label": "Stretch（引き伸ばし）"
            },
            {
              "value": "Center",
              "label": "Center（中央に等倍）"
            },
            {
              "value": "Tile",
              "label": "Tile（複数画像を並べる）"
            }
          ]
        },
        {
          "key": "TileCount",
          "title": "タイル枚数",
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 64,
          "step": 1
        },
        {
          "key": "PaddingLeft",
          "title": "左のPadding（px）",
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "step": 1
        },
        {
          "key": "PaddingRight",
          "title": "右のPadding（px）",
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "step": 1
        },
        {
          "key": "PaddingTop",
          "title": "上のPadding（px）",
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "step": 1
        },
        {
          "key": "PaddingBottom",
          "title": "下のPadding（px）",
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "step": 1
        }
      ],
      "itemTitle": "モニター",
      "list": {
        "columns": [
          "Folders",
          "Mode",
          "TileCount"
        ],
        "titleKey": "Folders",
        "showIndex": true,
        "confirmDelete": true
      }
    },
    {
      "default": 10,
      "maximum": 4096,
      "minimum": 0,
      "type": "number",
      "key": "tileMargin",
      "automation": true,
      "title": "タイル間の余白（px）"
    },
    {
      "maximum": 1000,
      "title": "履歴件数（モニターごと）",
      "key": "historyLimit",
      "automation": true,
      "type": "number",
      "description": "0で履歴を残しません。履歴は実行中だけ保持し、画像は表示ページだけ読み込みます。",
      "default": 30,
      "step": 1,
      "minimum": 0
    },
    {
      "default": 480,
      "maximum": 2048,
      "minimum": 1,
      "step": 1,
      "type": "number",
      "key": "thumbnailWidth",
      "automation": true,
      "title": "履歴サムネイルの幅（px）"
    },
    {
      "default": 360,
      "maximum": 2048,
      "minimum": 1,
      "step": 1,
      "type": "number",
      "key": "thumbnailHeight",
      "automation": true,
      "title": "履歴サムネイルの高さ（px）"
    },
    {
      "default": 30,
      "maximum": 1024,
      "minimum": 1,
      "step": 1,
      "type": "number",
      "key": "maxFileNameLength",
      "automation": true,
      "title": "履歴ファイル名の表示文字数"
    },
    {
      "key": "historyPageSize",
      "automation": true,
      "title": "最近使った壁紙の1ページの表示件数",
      "type": "number",
      "default": 4,
      "minimum": 1,
      "maximum": 1000,
      "step": 1,
      "description": "1～1000件。履歴を保存する件数とは別に設定できます。画像は選択したモニターの表示ページだけ読み込みます。"
    }
  ],
  "commands": [
    {
      "id": "at365.wallpaper-slideshow.next",
      "automation": true,
      "title": "次の壁紙に更新"
    },
    {
      "id": "at365.wallpaper-slideshow.history",
      "title": "最近使った壁紙を開く",
      "activateOnExecute": true
    },
    {
      "id": "at365.wallpaper-slideshow.data",
      "title": "壁紙のデータフォルダーを開く"
    },
    {
      "id": "at365.wallpaper-slideshow.background-settings",
      "title": "Windowsの背景設定を開く"
    }
  ],
  "pages": [{
    "id": "history", "title": "最近使った壁紙", "icon": "image", "source": "local",
    "ui": "web/history.html", "openCommand": "at365.wallpaper-slideshow.history", "defaultDisplay": "page"
  }],
  "pageActions": [
    { "id": "history.state" },
    { "id": "history.read", "parameters": { "monitor": "number", "page": "number", "offset": "number", "limit": "number", "generation": "string" } },
    { "id": "history.release", "parameters": { "generation": "string" } },
    { "id": "history.open", "parameters": { "generation": "string", "slot": "number" } },
    { "id": "history.delete-request", "parameters": { "generation": "string", "slot": "number" } },
    { "id": "history.delete-confirm", "parameters": { "confirmationToken": "string" } },
    { "id": "history.delete-cancel", "parameters": { "confirmationToken": "string" } }
  ],
  "settingActions": [
    {
      "title": "Windowsの背景設定を開く",
      "command": "at365.wallpaper-slideshow.background-settings",
      "description": "停止中に見えるWindows側の背景を確認します。スライドショーの表示に画像・スパンの準備は不要です。",
      "successMessage": "Windowsの背景設定を開きました。"
    }
  ],
  "settingSections": [
    {
      "id": "playback",
      "title": "スライドショー",
      "description": "壁紙の再生状態と切り替え間隔を設定します。",
      "settings": [
        "paused",
        "intervalSeconds",
        "tileMargin"
      ]
    },
    {
      "id": "monitors",
      "title": "モニターと画像",
      "description": "モニターごとに画像フォルダーと並べ方を設定します。",
      "settings": [
        "monitors"
      ]
    },
    {
      "id": "history",
      "title": "履歴の表示",
      "description": "残す履歴の件数と、最近使った壁紙の見た目を調整します。",
      "settings": [
        "historyLimit",
        "historyPageSize",
        "thumbnailWidth",
        "thumbnailHeight",
        "maxFileNameLength"
      ],
      "collapsible": true
    },
    {
      "id": "windows",
      "title": "Windowsの背景",
      "description": "停止中に見えるWindows側の背景を確認できます。",
      "settings": [],
      "actions": [
        "at365.wallpaper-slideshow.background-settings"
      ],
      "collapsible": true
    }
  ]
}
